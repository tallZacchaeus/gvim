# Copy to .env.local for local development; set the same keys in the Vercel
# dashboard (Settings -> Environment Variables) for Preview and Production.
# Never commit real values — .env.local is gitignored.

# ── Database (Turso) ─────────────────────────────────────────────────────────
# turso db show gvim --url  /  turso db tokens create gvim
TURSO_DATABASE_URL=libsql://gvim-<org>.turso.io
TURSO_AUTH_TOKEN=

# ── Admin login ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# node scripts/hash-password.mjs 'your-password'
ADMIN_PASSWORD_HASH=
# Signs the admin session cookie. Rotating it logs everyone out.
# Generate: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Media storage (Cloudflare R2, S3 API) ────────────────────────────────────
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_GALLERY_BUCKET=gvim-gallery
R2_SERMONS_BUCKET=gvim-sermons

# ── Public media URLs ────────────────────────────────────────────────────────
# Where browsers read files from. These are the rate-limited r2.dev development
# endpoints — replace with a custom bucket domain before real traffic.
PUBLIC_GALLERY_BASE=https://pub-294f59fe9da048038154a5cfe900e95d.r2.dev
PUBLIC_SERMONS_BASE=https://pub-2d6c5594e1c04df39a2223bd60d5b5d4.r2.dev
