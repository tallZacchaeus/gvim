{
  "name": "gvim-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev --d1=DB=gvim-db --r2=GALLERY_BUCKET=gvim-gallery --r2=SERMONS_BUCKET=gvim-sermons -- npm run dev",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "db:init": "wrangler d1 execute gvim-db --file=migrations/0001_init.sql",
    "db:init:local": "wrangler d1 execute gvim-db --local --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "@cloudflare/workerd-darwin-64": "^1.20260527.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "wrangler": "^3.80.0"
  }
}
