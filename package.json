{
  "name": "gvim-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "db:export": "node scripts/migrate-d1-to-turso.mjs export",
    "db:schema": "node scripts/migrate-d1-to-turso.mjs schema",
    "db:import": "node scripts/migrate-d1-to-turso.mjs import",
    "db:verify": "node scripts/migrate-d1-to-turso.mjs verify",
    "db:migrate": "node scripts/migrate-d1-to-turso.mjs all",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json",
    "test:api": "node scripts/smoke-api.mjs",
    "check:env": "node scripts/check-env.mjs",
    "dev:admin": "ADMIN_MOCK=1 vite"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@hookform/resolvers": "^5.9.1",
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "radix-ui": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^6.26.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": "22.x"
  }
